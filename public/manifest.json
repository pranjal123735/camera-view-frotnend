  "shortcuts": [
    {
      "name": "Start Detection",
      "short_name": "Detect",
      "description": "Start real-time object detection",
      "url": "/?action=start",
      "icons": [
        {
          "src": "/assets/shortcut-detect.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "View Analytics",
      "short_name": "Analytics",
      "description": "View safety analytics and performance metrics",
      "url": "/?view=analytics",
      "icons": [
        {
          "src": "/assets/shortcut-analytics.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Safety Alerts",
      "short_name": "Alerts",
      "description": "Check active safety alerts",
      "url": "/?view=alerts",
      "icons": [
        {
          "src": "/assets/shortcut-alerts.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "description": "Configure detection and personalization settings",
      "url": "/?view=settings",
      "icons": [
        {
          "src": "/assets/shortcut-settings.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.carvision.app",
      "id": "com.carvision.app"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/car-vision/id123456789"
    }
  ],
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+carvision",
      "url": "/handle?url=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/handle-detection-data",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"]
      }
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "handle_links": "preferred",
  "capture_links": "existing-client-navigate"
}